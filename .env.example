# Copy this file to .env and set your key locally. Never commit .env.
# Optional existing database; relative paths resolve against the project root.
# SKINTELLECT_DB_PATH=data/skintellect_moisturizers.db
# Optional local crawler session, only if required by your source access.
# SKINTELLECT_COOKIES=
GEMINI_API_KEY=
# Cloudflare AI Gateway: when CF_ACCOUNT_ID, CF_GATEWAY_ID and CF_AIG_TOKEN are
# all set, every Gemini request routes through
# https://gateway.ai.cloudflare.com/v1/{account}/{gateway}/{google-vertex-ai|google-ai-studio}
# with a cf-aig-authorization header. Set CF_GATEWAY_BYOK=1 only when the
# provider key is stored inside Cloudflare (the app then sends no provider
# credential). GCP_PROJECT_ID/GCP_REGION are accepted aliases for
# GOOGLE_CLOUD_PROJECT/GOOGLE_CLOUD_LOCATION.
# CF_ACCOUNT_ID=
# CF_GATEWAY_ID=
# CF_AIG_TOKEN=
# CF_GATEWAY_BYOK=0
# Production (Vercel) database: Turso over HTTP. When both are set the app
# talks to Turso for every catalog connection; when absent, local development
# falls back to the checked-out SQLite file. See docs/DEPLOY.md.
# TURSO_DATABASE_URL=libsql://skintellect-<your-org>.turso.io
# TURSO_AUTH_TOKEN=
# For the supplied Google Cloud configuration, use GOOGLE_API_KEY and project fields instead:
# GOOGLE_API_KEY=
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
# MODEL_ID=gemini-4-argon
# API_ENDPOINT=https://aiplatform.googleapis.com
# GEMINI_BACKEND=vertex
# GEMINI_THINKING_LEVEL=LOW
# Remove GEMINI_MODEL below when using MODEL_ID from the supplied configuration.
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_ATTEMPTS=2
RESEARCH_LLM_ENABLED=1
# Review extraction is performed offline through the pipeline, not per review-panel click.
RESEARCH_HYBRID_ENABLED=1

# Optional independent review extractor; unset preserves GEMINI_MODEL/MODEL_ID.
# GEMINI_ABSA_MODEL=your-benchmarked-model-id

# Optional short-lived OAuth token for Cloud embedContent when API-key auth is rejected.
# GEMINI_EMBEDDING_ACCESS_TOKEN=

# Embedding 2 uses the Google SDK and Cloud environment credentials by default.
# GEMINI_EMBEDDING_TRANSPORT=sdk
