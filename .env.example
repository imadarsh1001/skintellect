# Copy this file to .env and set your key locally. Never commit .env.
# Optional existing database; relative paths resolve against the project root.
# SKINTELLECT_DB_PATH=data/skintellect_moisturizers.db
# Optional local crawler session, only if required by your source access.
# SKINTELLECT_COOKIES=
GEMINI_API_KEY=
# For the supplied Google Cloud configuration, use GOOGLE_API_KEY and project fields instead:
# GOOGLE_API_KEY=
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
# MODEL_ID=gemini-4-argon
# API_ENDPOINT=https://aiplatform.googleapis.com
# GEMINI_BACKEND=vertex
# GEMINI_THINKING_LEVEL=LOW
# Remove GEMINI_MODEL below when using MODEL_ID from the supplied configuration.
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_ATTEMPTS=2
RESEARCH_LLM_ENABLED=1
# Review extraction is performed offline through the pipeline, not per review-panel click.
RESEARCH_HYBRID_ENABLED=1

# Optional independent review extractor; unset preserves GEMINI_MODEL/MODEL_ID.
# GEMINI_ABSA_MODEL=your-benchmarked-model-id

# Optional short-lived OAuth token for Cloud embedContent when API-key auth is rejected.
# GEMINI_EMBEDDING_ACCESS_TOKEN=

# Embedding 2 uses the Google SDK and Cloud environment credentials by default.
# GEMINI_EMBEDDING_TRANSPORT=sdk
